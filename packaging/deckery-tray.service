[Unit]
Description=Deckery system tray — service monitor and control
After=graphical-session.target
BindsTo=graphical-session.target

[Service]
Type=simple
ExecCondition=/bin/bash -c '! systemctl --user list-units --state=active "gamescope-session*" 2>/dev/null | grep -q gamescope-session'
ExecStart=/usr/bin/python3 /usr/lib/deckery/tray/deckery-tray.py
Restart=on-failure
RestartSec=3
Environment=XDG_SESSION_TYPE=wayland
Environment=PYTHONPATH=/usr/lib/deckery/tray

[Install]
WantedBy=graphical-session.target
